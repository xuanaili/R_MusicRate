# ===================== 前端（Vue CLI）忽略项 =====================
# 依赖包（核心，必忽略）
frontend/node_modules/
# 打包产物
frontend/dist/
frontend/build/
# 缓存文件
frontend/.cache/
frontend/.npm/
# 环境变量（本地配置）
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
# Vue CLI临时文件
frontend/.pnpm-debug.log
frontend/yarn-debug.log
frontend/yarn-error.log
frontend/npm-debug.log*

# ===================== 后端（Flask）忽略项 =====================
# Python虚拟环境
backend/venv/
# Python缓存
__pycache__/
*.py[cod]
*$py.class
# Python日志
backend/*.log
# 数据库文件（如果后续用SQLite）
backend/*.db
# 数据
backend/data/album_covers
backend/data/album_track


# 工具类
backend/tools/ffmpeg/*.exe
backend/tools/unlock/*.exe
# ===================== 通用忽略项 =====================
# PyCharm配置
.idea/
*.iml
*.ipr
*.iws
# 系统文件
.DS_Store
Thumbs.db
# 临时文件
*.tmp
*.bak
# CDN版前端的临时文件（可选）
frontend-cdn/